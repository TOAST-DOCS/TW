# Copy this file to .env and fill in your own values. Never commit .env.

# GitHub Personal Access Token (recommended: fine-grained, public repo read-only, "Contents" read)
# Without this, GitHub API calls are unauthenticated and capped at 60 requests/hour,
# which is not enough for the ~190 repos in TOAST-DOCS.
GITHUB_TOKEN=

# GitHub org to monitor (defaults to TOAST-DOCS if unset)
GITHUB_ORG=TOAST-DOCS

# Server port (defaults to 3000 if unset)
PORT=3000
